# ==========================================
# Student Attendance Management System - Config
# ==========================================

# Application Settings
APP_NAME="Face Attendance Management System"
APP_ENV=development
DEBUG=True

# Database Configuration
# Options: 'sqlite' (zero-config, local) or 'mysql' (production server)
DB_TYPE=sqlite

# SQLite Settings (Used if DB_TYPE=sqlite)
SQLITE_PATH=data/attendance_system.db

# MySQL Settings (Used if DB_TYPE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=student_management

# Face Recognition Settings
CAMERA_INDEX=0
CONFIDENCE_THRESHOLD=0.60
DETECTION_CONFIDENCE=0.50

# UI Theme
# Options: 'Dark', 'Light', 'System'
UI_THEME=Dark
UI_COLOR_THEME=blue
